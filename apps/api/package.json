{
  "name": "@ntfs/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && node --watch dist/main.js",
    "start": "node dist/main.js",
    "db:migrate": "tsc -p tsconfig.json && node dist/database/cli.js migrate",
    "db:status": "tsc -p tsconfig.json && node dist/database/cli.js status",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js",
    "admin:init": "tsc -p tsconfig.json && node dist/identity/bootstrap.js",
    "identity:smoke": "tsc -p tsconfig.json && node dist/identity/integration-smoke.js",
    "organization:smoke": "tsc -p tsconfig.json && node dist/organization/integration-smoke.js"
  },
  "dependencies": {
    "@ntfs/contracts": "workspace:*",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "dotenv": "18.0.7",
    "mysql2": "3.24.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31",
    "zod": "4.6.7"
  },
  "type": "module"
}
