{
  "name": "@ntfs/desktop",
  "version": "2.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build-icons.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node scripts/build-icons.mjs && tsc -p tsconfig.json && electron .",
    "test": "tsc -p tsconfig.json && node --test dist/*.test.js",
    "package": "node scripts/build-icons.mjs && tsc -p tsconfig.json && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "sharp": "0.34.5"
  },
  "description": "下次一定 Windows 桌面客户端",
  "author": "Next Time, For Sure",
  "build": {
    "appId": "cn.nexttimeforsure.desktop",
    "productName": "下次一定",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*.js",
      "!dist/**/*.test.js",
      "assets/**/*"
    ],
    "publish": {
      "provider": "generic",
      "url": "https://github.com/98roc/next-time-for-sure/releases/latest/download/"
    },
    "win": {
      "signExecutable": false,
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "perMachine": false
    },
    "artifactName": "NextTimeForSure-${version}-Setup.${ext}",
    "electronDist": "node_modules/electron/dist"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
