# Copy to .deploy.production.local. Values are literal: no shell expansion or quotes.
# This is deployment configuration, separate from the local development .env.local.
DEPLOY_HOST=
DEPLOY_SSH_PORT=22
DEPLOY_USER=
# Optional; leave empty to use an SSH key/agent or enter the password interactively.
DEPLOY_PASSWORD=
# Optional; used only by InitAdmin through SSH stdin, never added to an image or runtime env.
INITIAL_ADMIN_PASSWORD=
DEPLOY_PATH=
HTTP_BIND=
HTTP_PORT=
DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=next_time_for_sure
API_HOST=0.0.0.0
API_PORT=3100
NODE_ENV=production
